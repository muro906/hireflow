# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=hireflow
DB_PASSWORD=hireflow_secret
DB_NAME=hireflow
DB_SSLMODE=disable
# Computed: postgres://hireflow:hireflow_secret@localhost:5432/hireflow?sslmode=disable
DATABASE_URL=postgres://hireflow:hireflow_secret@localhost:5432/hireflow?sslmode=disable

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ─── Storage (MinIO / S3) ──────────────────────────────────────────────────────
STORAGE_PROVIDER=minio       # minio | s3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hireflow-files
MINIO_USE_SSL=false
# For production S3:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET=hireflow-files

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp           # smtp | resend
EMAIL_FROM=noreply@hireflow.local
EMAIL_FROM_NAME=HireFlow

# SMTP (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Resend (production)
# RESEND_API_KEY=re_...

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
